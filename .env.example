# Copy to .env (or export in the shell). Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./resume_ai.db
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed by CORS (Nuxt dev defaults if unset).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama — local LLM for resume generation (https://ollama.com)
# Start with: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
# OpenAI SDK placeholder only; Ollama does not require a real key
OLLAMA_API_KEY=ollama

# BERT-family embeddings via sentence-transformers (Hugging Face)
BERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
BERT_KEYWORD_THRESHOLD=0.35
# Set true to retry loading the model after a previous failure in-process
BERT_RETRY_LOAD=false

# If true (default), Ollama down / BERT load errors fall back to
# local template + keyword heuristics and label generated_by honestly.
# If false, /api/resume/generate and /analyze return HTTP 503 instead.
AI_ALLOW_FALLBACK=true

# HeadHunter public vacancy search (HR market watch). No OAuth token.
HH_API_BASE=https://api.hh.ru
HH_USER_AGENT=ResumeAI/1.3.0 (dev)
HH_AREA=40
HH_PER_PAGE=20
